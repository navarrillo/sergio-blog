{
  "openapi": "3.1.0",
  "info": {
    "title": "Sergio Navarro Blog API",
    "version": "1.0.0",
    "description": "Anonymous read-only API. 60 requests/minute/IP shared with MCP. Posts list returns items and next_cursor; drafts and future-dated posts are excluded."
  },
  "servers": [
    {
      "url": "https://blog.sergionavarro.me"
    }
  ],
  "paths": {
    "/api/v1/posts": {
      "get": {
        "summary": "Search published posts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Full text query"
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact tag"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "article, note, or x_post"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO timestamp"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Default 20, maximum 100"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque next_cursor from a previous response"
          }
        ],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/posts/{slug}": {
      "get": {
        "summary": "Read a post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/posts/{slug}.md": {
      "get": {
        "summary": "Read Markdown",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/posts/{slug}.txt": {
      "get": {
        "summary": "Read plain text",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "summary": "Tags with public counts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "Public projects",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Public aggregate statistics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Published data only"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Shared IP rate limit exceeded; retry after 60 seconds"
          }
        }
      }
    }
  }
}
