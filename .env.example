# Copy to config/.env with mode 600, or run bin/setup. Never commit secrets.
PUBLIC_ORIGIN=http://localhost:4321
# false ONLY for local HTTP. Production requires true and HTTPS (__Host- cookie).
COOKIE_SECURE=false
# Exact trusted peer IPs, comma separated. Empty trusts no forwarding headers.
TRUSTED_PROXIES=
DATA_DIR=./data
UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups
# Host bind mount paths. Production sets these to persistent absolute paths.
BLOG_DATA_PATH=./data
BLOG_UPLOADS_PATH=./uploads
BLOG_BACKUPS_PATH=./backups
BLOG_PORT=8010
BLOG_IMAGE=blog:live
DEMO_MODE=false
SESSION_SECRET=
CSRF_SECRET=
# Separate analytics compose. Internal URL must stay on the local/shared network.
UMAMI_INTERNAL_URL=http://umami:3000
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
UMAMI_TWO_FACTOR_KEY=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
UMAMI_PGDATA_PATH=./pgdata
UMAMI_BACKUPS_PATH=./backups
UMAMI_PORT=8011
