# Preserve Umami and its dependencies; pin the Node 22 binary to the reviewed release.
# Same Node major and Alpine 3.24 ABI as the pinned upstream image (pinned by digest).
FROM node:22.23.4-alpine3.24 AS patched-node
FROM ghcr.io/umami-software/umami:3.4.1@sha256:e69d1a7932e9dab0fc523edc7be1f3a53f3c261f57856fc2167ae74a8fc022e8
COPY --from=patched-node /usr/local/bin/node /usr/local/bin/node
RUN test "$(node --version)" = "v22.23.4"
