# Preserve Umami and its dependencies; replace only the vulnerable Node 22 binary.
# Same Node major and Alpine 3.24 ABI as the pinned upstream image.
FROM node:22.23.4-alpine3.24 AS patched-node
FROM ghcr.io/umami-software/umami:3.4.0
COPY --from=patched-node /usr/local/bin/node /usr/local/bin/node
RUN test "$(node --version)" = "v22.23.4"
