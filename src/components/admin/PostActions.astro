---
import { visibility } from '../../lib/editorial';
const { post, csrf, returnTo } = Astro.props;
const label = visibility(post);
const live = post.status === 'published' && label !== 'Scheduled';
---

<div class="row-actions">
  <a
    href={'/admin/edit?id=' +
      post.id +
      '&return_to=' +
      encodeURIComponent(returnTo)}>Edit</a
  >
  <a href={'/admin/preview?id=' + post.id}>Preview</a>
  {live && <a href={'/posts/' + post.live_slug}>View live</a>}
  <form action="/api/admin/pin" method="post" data-admin-form data-reload>
    <input type="hidden" name="csrf" value={csrf} /><input
      type="hidden"
      name="id"
      value={post.id}
    />
    <input
      type="hidden"
      name="pinned"
      value={post.featured ? '0' : '1'}
    /><input type="hidden" name="return_to" value={returnTo} />
    <button class="text-button">{post.featured ? 'Unpin' : 'Pin'}</button>
  </form>
  {
    post.status !== 'trash' && (!live || post.has_changes) && (
      <form
        action="/api/admin/post-action"
        method="post"
        data-admin-form
        data-reload
        data-confirm={
          live
            ? 'Publish the saved changes to this live article?'
            : 'Publish this post now? It will be visible to readers.'
        }
      >
        <>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="id" value={post.id} />
          <input type="hidden" name="version" value={post.edit_version} />
          <input type="hidden" name="intent" value="publish" />
          <input type="hidden" name="return_to" value={returnTo} />
        </>
        <button class="text-button">
          {live
            ? 'Update live post'
            : post.status === 'published'
              ? 'Publish now'
              : 'Publish'}
        </button>
      </form>
    )
  }
  {
    post.status === 'published' && (
      <form
        action="/api/admin/post-action"
        method="post"
        data-admin-form
        data-reload
        data-confirm="Unpublish this post? It will be hidden from readers and kept as a private draft."
      >
        <>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="id" value={post.id} />
          <input type="hidden" name="version" value={post.edit_version} />
          <input type="hidden" name="intent" value="unpublish" />
          <input type="hidden" name="return_to" value={returnTo} />
        </>
        <button class="text-button">Unpublish</button>
      </form>
    )
  }
  <form
    action="/api/admin/post-action"
    method="post"
    data-admin-form
    data-reload
    data-confirm={post.status === 'trash'
      ? undefined
      : 'Move this post to trash? It will be hidden and can be restored later.'}
  >
    <input type="hidden" name="csrf" value={csrf} /><input
      type="hidden"
      name="id"
      value={post.id}
    /><input type="hidden" name="version" value={post.edit_version} /><input
      type="hidden"
      name="intent"
      value={post.status === 'trash' ? 'restore' : 'trash'}
    /><input type="hidden" name="return_to" value={returnTo} />
    <button class="text-button"
      >{post.status === 'trash' ? 'Restore to drafts' : 'Trash'}</button
    >
  </form>
</div>
