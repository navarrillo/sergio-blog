---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import {
  queryPosts,
  pinnedPosts,
  getPost,
  tags,
  projects,
  renderMarkdown,
  redirectFor,
} from '../lib/content';
import { publicStats } from '../lib/analytics';
import { setting } from '../lib/db';
const route = Astro.params.route || '';
const parts = route.split('/');
const isHome = !route,
  isArchive =
    route === 'posts' ||
    (parts[0] === 'tags' &&
      parts.length === 2 &&
      /^[a-z0-9-]+$/.test(parts[1])),
  isArticle = parts[0] === 'posts' && parts.length === 2,
  isProjects = route === 'projects',
  isStats = route === 'stats',
  isApi = route === 'api' || route === 'mcp-connect';
const post = isArticle ? getPost(parts[1]) : undefined;
if (isArticle && !post) {
  const target = redirectFor(parts[1]);
  if (target) return Astro.redirect('/posts/' + target.slug, 301);
}
const missing =
  (!isHome && !isArchive && !isArticle && !isProjects && !isStats && !isApi) ||
  (isArticle && !post);
if (missing) Astro.response.status = 404;
const filters = new URLSearchParams(Astro.url.searchParams);
if (parts[0] === 'tags') filters.set('tag', parts[1]);
if (isHome) filters.set('limit', '20');
let result = { items: [] as any[], next_cursor: null as string | null };
let queryError = false;
if (isHome || isArchive) {
  try {
    result = queryPosts(filters);
  } catch {
    queryError = true;
    Astro.response.status = 400;
  }
}
const allTags = isHome || isArchive ? (tags() as any[]) : [];
const allProjects = isHome || isProjects ? (projects() as any[]) : [];
const stats = isStats ? await publicStats() : null;
const featured = isHome ? pinnedPosts() : [];
const title = missing
  ? 'Page not found'
  : post?.title ||
    (isHome
      ? 'Sergio Navarro'
      : isArchive
        ? 'Writing'
        : isProjects
          ? 'Projects'
          : isStats
            ? 'Stats'
            : 'API & MCP');
const next = new URL(Astro.url);
if (result.next_cursor) next.searchParams.set('cursor', result.next_cursor);
const photo = setting('photo');
const links = JSON.parse(setting('links', '[]'));
const layout =
  Astro.url.searchParams.get('layout') === 'cards' ? 'cards' : 'list';
const isFiltered = ['q', 'type', 'tag', 'cursor'].some(
  (key) => filters.has(key) && filters.get(key),
);
function viewLink(key: string, value: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete('cursor');
  if (parts[0] === 'tags') params.set('tag', parts[1]);
  if (value) params.set(key, value);
  else params.delete(key);
  return '/posts' + (params.size ? '?' + params : '');
}
---

<Base title={title} post={post} description={post?.summary}>
  {
    isHome && (
      <section class="intro">
        {photo && (
          <img
            class="portrait"
            src={photo}
            width="64"
            height="64"
            alt="Sergio Navarro"
          />
        )}
        <div>
          <h1>Hi, I’m Sergio Navarro.</h1>
          <p>
            {setting(
              'bio',
              'I write about the things I’m building, learning, and thinking about.',
            )}
          </p>
          {links.length > 0 && (
            <div class="intro-links">
              {links.map((link: any) => (
                <a href={link.url} rel="noopener noreferrer" data-outbound>
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
  {
    (isHome || isArchive) && (
      <>
        <div class="archive-controls">
          <nav aria-label="Filter writing">
            <span>Filter:</span>
            {[
              ['', 'all'],
              ['article', 'articles'],
              ['note', 'notes'],
              ['x_post', 'X posts'],
            ].map(([value, label]) => (
              <a
                href={viewLink('type', value)}
                aria-current={
                  (filters.get('type') || '') === value ? 'page' : undefined
                }
              >
                {label}
              </a>
            ))}
          </nav>
          <nav aria-label="Archive layout">
            <span>Layout:</span>
            <a
              href={viewLink('layout', 'list')}
              aria-current={layout === 'list' ? 'page' : undefined}
            >
              list
            </a>
            <a
              href={viewLink('layout', 'cards')}
              aria-current={layout === 'cards' ? 'page' : undefined}
            >
              cards
            </a>
          </nav>
        </div>
        <form class="filters" method="get" action="/posts" role="search">
          <label class="search-label">
            <>
              <span class="sr-only">Search writing</span>
              <input
                type="search"
                name="q"
                placeholder="Search all posts…"
                value={filters.get('q') || ''}
              />
            </>
          </label>
          {filters.get('type') && (
            <input type="hidden" name="type" value={filters.get('type')!} />
          )}
          {layout === 'cards' && (
            <input type="hidden" name="layout" value="cards" />
          )}
          <label class="tag-filter">
            <>
              <span class="sr-only">Tag</span>
              <select name="tag">
                <option value="">All topics</option>
                {allTags.map((tag) => (
                  <option
                    selected={filters.get('tag') === tag.tag}
                    value={tag.tag}
                  >
                    {tag.tag} ({tag.count})
                  </option>
                ))}
              </select>
            </>
          </label>
          <button type="submit">Search</button>
        </form>
        {isHome && !isFiltered && featured.length > 0 && (
          <section class="pinned-posts" aria-labelledby="pinned-title">
            <h2 id="pinned-title">Pinned</h2>
            <PostList posts={featured} layout={layout} />
          </section>
        )}
        {isArchive && (
          <h1 class="archive-title">
            {parts[0] === 'tags'
              ? '#' + parts[1]
              : filters.get('q')
                ? 'Search results'
                : 'All writing'}
          </h1>
        )}
        {queryError ? (
          <p role="alert">
            Invalid search parameters. <a href="/posts">Reset search</a>
          </p>
        ) : result.items.length ? (
          <PostList posts={result.items} grouped layout={layout} />
        ) : (
          <div class="empty" data-no-results>
            <h2>{isFiltered ? 'No posts found.' : 'No posts yet.'}</h2>
            <p>
              {isFiltered
                ? 'Try another search or browse all writing.'
                : 'The first post will appear here when it is published.'}
            </p>
            {isFiltered && <a href="/posts">Clear filters</a>}
          </div>
        )}
        {result.next_cursor && (
          <a class="pagination" href={next.pathname + next.search}>
            Older posts →
          </a>
        )}
      </>
    )
  }
  {
    post && (
      <article class="article">
        <header class="article-header">
          <>
            <div class="eyebrow">
              {post.type}{' '}
              <>
                <span> / </span>
                <time datetime={post.published_at}>
                  {new Date(post.published_at).toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </>
            </div>
            <h1>{post.title}</h1>
            <p class="lead">{post.summary}</p>
            <div class="tags">
              {post.tags.map((t: string) => (
                <a href={'/tags/' + t}>#{t}</a>
              ))}
            </div>
          </>
        </header>
        {post.image && <img class="cover" src={post.image} alt="" />}
        <div class="prose" set:html={renderMarkdown(post.body)} />
        {post.source_url && (
          <p>
            <a href={post.source_url} rel="noopener noreferrer" data-outbound>
              View original post ↗
            </a>
          </p>
        )}
        <div class="article-bottom">
          <>
            <span>Written by Sergio Navarro</span>
            <a href={'/api/v1/posts/' + post.slug + '.md'}>
              Read as Markdown ↗
            </a>
          </>
        </div>
      </article>
    )
  }
  {
    isProjects && (
      <>
        <h1>Projects</h1>
        <div class="projects-grid">
          {allProjects.map((p) => (
            <article class="project-card">
              {p.image && <img src={p.image} alt="" loading="lazy" />}
              <span class="project-status">● {p.status}</span>
              <h2>{p.name}</h2>
              <p>{p.description}</p>
              <div class="intro-links">
                {p.url && (
                  <a
                    href={p.url}
                    data-project={p.name}
                    rel="noopener noreferrer"
                  >
                    Visit project ↗
                  </a>
                )}
                {p.source_url && (
                  <a
                    href={p.source_url}
                    data-outbound
                    rel="noopener noreferrer"
                  >
                    Source ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
        {!allProjects.length && (
          <div class="empty">
            <h2>Something is taking shape.</h2>
            <p>Projects will appear here when they are ready to share.</p>
          </div>
        )}
      </>
    )
  }
  {
    stats && (
      <>
        <>
          <section class="page-heading">
            <>
              <h1>Stats</h1>
              <p>Writing activity and the topics that connect it.</p>
            </>
          </section>
          <div class="stat-grid">
            {['article', 'note', 'x_post'].map((type) => (
              <div>
                <strong>
                  {Number(
                    (stats.editorial as any[]).find((p) => p.type === type)
                      ?.count || 0,
                  )}
                </strong>
                <span>{type === 'x_post' ? 'Posts from X' : type + 's'}</span>
              </div>
            ))}
          </div>
          <section class="stats-section">
            <div class="topic-list">
              {(stats.tags as any[]).map((t) => (
                <a href={'/tags/' + t.tag}>
                  #{t.tag} <span>{t.count}</span>
                </a>
              ))}
            </div>
            {!stats.tags.length && <p>No published topics yet.</p>}
          </section>
          <section class="stats-section">
            <h2>Most read · last 30 days</h2>
            {stats.popular.length ? (
              <ol>
                {stats.popular.map((p: any) => (
                  <li>
                    <a href={p.path}>
                      {getPost(p.path.split('/').at(-1))?.title}
                    </a>{' '}
                    <span>{p.views} views</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p>Traffic statistics are not available yet.</p>
            )}
            <p class="muted">
              {stats.updated_at
                ? 'Last updated ' +
                  new Date(stats.updated_at).toUTCString() +
                  '. The last available snapshot is retained during outages.'
                : 'Analytics has not collected a snapshot yet.'}
            </p>
          </section>
        </>
      </>
    )
  }
  {
    isApi && (
      <>
        <>
          <section class="page-heading">
            <>
              <h1>API &amp; MCP</h1>
              <p>
                Read published writing through a small, public API. No key
                needed.
              </p>
            </>
          </section>
          <div class="prose">
            <>
              <h2>Content API</h2>
              <p>
                All endpoints are read only and share a limit of 60 requests per
                minute per IP with MCP.
              </p>
              <pre>
                <code>
                  GET /api/v1/posts?q=building&amp;tag=projects&amp;type=article
                  <br />
                  GET /api/v1/posts/:slug
                  <br />
                  GET /api/v1/posts/:slug.md
                  <br />
                  GET /api/v1/posts/:slug.txt
                  <br />
                  GET /api/v1/tags
                  <br />
                  GET /api/v1/projects
                  <br />
                  GET /api/v1/stats
                </code>
              </pre>
              <p>
                The posts endpoint accepts <code>q</code>, <code>tag</code>,{' '}
                <code>type</code>, <code>since</code> (ISO date),{' '}
                <code>limit</code> (default 20, maximum 100), and{' '}
                <code>cursor</code>. Follow <code>next_cursor</code> for the
                next page.
              </p>
              <p>
                <a href="/openapi.json">OpenAPI contract ↗</a> ·{' '}
                <a href="/llms.txt">llms.txt ↗</a>
              </p>
              <h2>Connect with MCP</h2>
              <p>
                Add this remote Streamable HTTP server URL to a compatible MCP
                client:
              </p>
              <pre>
                <code>{new URL('/mcp', Astro.url.origin).href}</code>
              </pre>
              <p>
                Available tools: <code>search_posts</code>,{' '}
                <code>get_post</code>, <code>list_tags</code>, and{' '}
                <code>list_projects</code>. Searches return summaries; use{' '}
                <code>get_post</code> for the full Markdown. This server uses
                anonymous access and has no persistent sessions.
              </p>
              <h2>Feeds</h2>
              <p>
                <a href="/rss.xml">All writing</a> ·{' '}
                <a href="/rss.xml?type=article">Articles only</a>
              </p>
            </>
          </div>
        </>
      </>
    )
  }
  {
    missing && (
      <section class="empty error-page">
        <>
          <span class="eyebrow">404 / A SMALL DETOUR</span>
          <h1>
            This page wandered off<span class="accent">.</span>
          </h1>
          <p>The address may have changed, or the page is not published.</p>
          <a class="button" href="/">
            Back to the homepage ↗
          </a>
        </>
      </section>
    )
  }
</Base>
