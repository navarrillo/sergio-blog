---
import '../styles/site.css';
Astro.response.status = 500;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><title>Temporarily unavailable · Sergio Navarro</title><link
      rel="icon"
      href="/favicon.svg"
    /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link
      rel="manifest"
      href="/site.webmanifest"
    /><meta name="apple-mobile-web-app-title" content="Sergio Navarro" /><meta
      name="theme-color"
      content="#ffffff"
    /></head
  ><body
    ><main class="shell error-page">
      <span class="eyebrow">500 / A SHORT PAUSE</span><h1>
        A little interruption.
      </h1><p>
        This page is temporarily unavailable. Please try again in a moment.
      </p><a href="/">Back to the homepage</a>
    </main></body
  >
</html>
