---
import Base from '../../layouts/Base.astro';
import { randomUUID } from 'node:crypto';
import MediaPicker from '../../components/admin/MediaPicker.astro';
import PostActions from '../../components/admin/PostActions.astro';
import Pagination from '../../components/admin/Pagination.astro';
import ProjectsWorkspace from '../../components/admin/ProjectsWorkspace.astro';
import { db, setting } from '../../lib/db';
import { projects, renderMarkdown } from '../../lib/content';
import {
  adminTags,
  listAdminPosts,
  visibility,
  workingPost,
} from '../../lib/editorial';
import { analytics } from '../../lib/analytics';
const page = Astro.params.page || '';
const csrf = Astro.locals.session?.csrf;
const id = Number(Astro.url.searchParams.get('id'));
const post = id
  ? workingPost(id)
  : {
      title: '',
      slug: '',
      summary: '',
      body: '',
      tags: [],
      type: 'article',
      status: 'draft',
      image: '',
      source_url: '',
      featured: false,
      published_at: null,
      edit_version: 0,
      has_changes: false,
    };
const creator = (tokenId: number | null | undefined) =>
  tokenId
    ? (
        db()
          .prepare('SELECT name FROM agent_tokens WHERE id=?')
          .get(tokenId) as any
      )?.name
    : null;
const revisions = id
  ? (db()
      .prepare(
        'SELECT id,created_at,kind FROM revisions WHERE post_id=? ORDER BY id DESC LIMIT 100',
      )
      .all(id) as any[])
  : [];
const listing = page === '' ? listAdminPosts(Astro.url.searchParams) : null;
const knownTags = page !== 'login' ? adminTags() : [];
const allProjects = page === 'projects' ? (projects() as any[]) : [];
const selectedProject = allProjects.find((p) => p.id === id);
const projectEditing =
  page === 'projects' &&
  (Astro.url.searchParams.has('id') || Astro.url.searchParams.has('new'));
const a = page === '' ? await analytics() : null;
const inboxQuery = (Astro.url.searchParams.get('q') || '').slice(0, 300);
const inboxWhere = inboxQuery ? " WHERE text LIKE ? ESCAPE '\\'" : '';
const inboxValues = inboxQuery
  ? ['%' + inboxQuery.replace(/[\\%_]/g, '\\$&') + '%']
  : [];
const inboxTotal =
  page === 'inbox'
    ? Number(
        (
          db()
            .prepare('SELECT count(*) AS count FROM x_imports' + inboxWhere)
            .get(...inboxValues) as any
        ).count,
      )
    : 0;
const inboxPages = Math.max(1, Math.ceil(inboxTotal / 20));
const inboxPage = Math.min(
  inboxPages,
  Math.max(1, Math.floor(Number(Astro.url.searchParams.get('page')) || 1)),
);
const inbox =
  page === 'inbox'
    ? (db()
        .prepare(
          'SELECT * FROM x_imports' +
            inboxWhere +
            ' ORDER BY date DESC,id DESC LIMIT 20 OFFSET ?',
        )
        .all(...inboxValues, (inboxPage - 1) * 20) as any[])
    : [];
let importReport: any = null;
if (Astro.url.searchParams.has('imported')) {
  try {
    importReport = JSON.parse(setting('import_report', '{}'));
  } catch {
    /* Older reports remain private. */
  }
}
let links: { label: string; url: string }[] = [];
if (page === 'settings') {
  try {
    links = JSON.parse(setting('links', '[]'));
  } catch {
    links = [];
  }
}
const known = [
  '',
  'login',
  'edit',
  'preview',
  'projects',
  'settings',
  'inbox',
  'tags',
];
const missing =
  !known.includes(page) ||
  (['edit', 'preview'].includes(page) && !post) ||
  (page === 'projects' && Astro.url.searchParams.has('id') && !selectedProject);
if (missing) Astro.response.status = 404;
const returnParam = Astro.url.searchParams.get('return_to') || '/admin';
const returnTo =
  returnParam === '/admin' || returnParam.startsWith('/admin?')
    ? returnParam
    : '/admin';
const currentList = Astro.url.pathname + Astro.url.search;
const live = post?.status === 'published' && visibility(post) !== 'Scheduled';
const headings: Record<string, string> = {
  '': 'Your writing',
  edit: id ? 'Edit post' : 'New post',
  preview: 'Private preview',
  settings: 'Site settings',
  projects: 'Projects',
  inbox: 'X inbox',
  tags: 'Tags',
};
---

<Base
  title={page === 'login' ? 'Sign in' : headings[page] || 'Not found'}
  admin
>
  {
    page === 'login' ? (
      <section class="login">
        <>
          <span class="eyebrow">PRIVATE WORKSPACE</span>
          <h1>
            Welcome back<span class="accent">.</span>
          </h1>
        </>
        <p>Sign in with your password and authenticator code.</p>
        <form
          method="post"
          action="/api/admin/login"
          data-admin-form
          data-login
        >
          <label>
            Password
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              required
              maxlength="1024"
            />
          </label>
          <label>
            Authentication code
            <input
              name="code"
              inputmode="numeric"
              pattern="[0-9]{6}"
              autocomplete="one-time-code"
              required
              maxlength="6"
            />
          </label>
          <button type="submit">Sign in →</button>
        </form>
      </section>
    ) : (
      <>
        <div class="admin-heading">
          <div>
            <>
              <span class="eyebrow">YOUR PRIVATE WORKSPACE</span>
              <h1>{headings[page] || 'Page not found'}</h1>
            </>
          </div>
          <form action="/api/admin/logout" method="post">
            <>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="quiet">Sign out</button>
            </>
          </form>
        </div>
        {page !== '' && !projectEditing && (
          <a class="back-link" href={returnTo}>
            ← Back to posts
          </a>
        )}
        {Astro.url.searchParams.has('saved') && (
          <p class="notice" role="status">
            Saved successfully.
          </p>
        )}
        {Astro.url.searchParams.has('deleted') && page === 'projects' && (
          <p class="notice" role="status">
            Project deleted.
          </p>
        )}
        {missing && (
          <p>
            Page not found.{' '}
            {page === 'projects' && (
              <a href="/admin/projects">Back to projects</a>
            )}
          </p>
        )}
        {page === '' && listing && (
          <>
            {a && (
              <details class="admin-analytics">
                <summary>
                  Last 30 days ·{' '}
                  {a.stats?.pageviews?.value ?? a.stats?.pageviews ?? '—'} page
                  views
                </summary>
                <p>
                  {a.stats?.visitors?.value ?? a.stats?.visitors ?? '—'}{' '}
                  visitors ·{' '}
                  <a href="https://analytics.sergionavarro.me">Open Umami ↗</a>
                </p>
                <small>
                  Updated {a.updated_at || 'when analytics is available'}
                </small>
              </details>
            )}
            <div class="admin-actions">
              <a class="button" href="/admin/edit">
                + New post
              </a>
              <a href="/admin/tags">Manage tags</a>
              <a href="/api/admin/export">Export everything ↓</a>
            </div>
            <form class="admin-filters" method="get" action="/admin">
              <label class="search-field">
                Search
                <input
                  name="q"
                  type="search"
                  value={Astro.url.searchParams.get('q')}
                  placeholder="Search title or text"
                />
              </label>
              <label>
                Status
                <select name="status">
                  {[
                    ['', 'All active'],
                    ['draft', 'Draft'],
                    ['published', 'Published'],
                    ['changes', 'Unpublished changes'],
                    ['scheduled', 'Scheduled'],
                    ['trash', 'Trash'],
                  ].map(([value, label]) => (
                    <option
                      value={value}
                      selected={Astro.url.searchParams.get('status') === value}
                    >
                      {label}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Type
                <select name="type">
                  {[
                    ['', 'All types'],
                    ['article', 'Article'],
                    ['note', 'Note'],
                    ['x_post', 'X post / thread'],
                  ].map(([value, label]) => (
                    <option
                      value={value}
                      selected={Astro.url.searchParams.get('type') === value}
                    >
                      {label}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Tag
                <select name="tag">
                  <option value="">All tags</option>
                  {knownTags.map((t) => (
                    <option
                      selected={Astro.url.searchParams.get('tag') === t.tag}
                    >
                      {t.tag}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Sort
                <select name="sort">
                  {[
                    ['', 'Recently edited'],
                    ['title', 'Title A–Z'],
                    ['oldest', 'Oldest first'],
                  ].map(([value, label]) => (
                    <option
                      value={value}
                      selected={Astro.url.searchParams.get('sort') === value}
                    >
                      {label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="checkbox">
                <input
                  type="checkbox"
                  name="pinned"
                  value="1"
                  checked={Astro.url.searchParams.get('pinned') === '1'}
                />
                Pinned only
              </label>
              <label class="checkbox">
                <input
                  type="checkbox"
                  name="bot"
                  value="1"
                  checked={Astro.url.searchParams.get('bot') === '1'}
                />
                Bot-created only
              </label>
              <button class="secondary">Apply filters</button>
              <a href="/admin">Reset</a>
            </form>
            <form
              id="bulk-form"
              method="post"
              action="/api/admin/bulk"
              data-admin-form
              data-reload
            >
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="return_to" value={currentList} />
              <div class="bulk-actions">
                <span data-selection-count>0 selected</span>
                <label class="sr-only" for="bulk-intent">
                  Bulk action
                </label>
                <select id="bulk-intent" name="intent">
                  <option value="pin">Pin</option>
                  <option value="unpin">Unpin</option>
                  <option value="trash">Move to trash</option>
                  <option value="restore">Restore to drafts</option>
                </select>
                <button class="quiet" disabled data-requires-selection>
                  Apply to selected
                </button>
              </div>
            </form>
            <div class="table-wrap">
              <table class="posts-table">
                <thead>
                  <tr>
                    <th>
                      <input
                        type="checkbox"
                        data-select-all="bulk-form"
                        aria-label="Select all posts on this page"
                      />
                    </th>
                    <th>Post</th>
                    <th>Status</th>
                    <th>Edited</th>
                  </tr>
                </thead>
                <tbody>
                  {listing.items.map((p) => (
                    <tr>
                      <td>
                        <input
                          type="checkbox"
                          form="bulk-form"
                          name="selected"
                          value={p.id}
                          aria-label={'Select ' + p.title}
                        />
                        <input
                          type="hidden"
                          form="bulk-form"
                          name={'version_' + p.id}
                          value={p.edit_version}
                        />
                      </td>
                      <td>
                        <a
                          class="admin-post-title"
                          href={
                            '/admin/edit?id=' +
                            p.id +
                            '&return_to=' +
                            encodeURIComponent(currentList)
                          }
                        >
                          {p.title}
                        </a>
                        <div class="post-meta">
                          {p.type === 'x_post' ? 'X post / thread' : p.type}
                          {p.featured && ' · Pinned'}
                          {creator(p.created_by_token_id) &&
                            ' · Created by ' + creator(p.created_by_token_id)}
                        </div>
                        <PostActions
                          post={p}
                          csrf={csrf}
                          returnTo={currentList}
                        />
                      </td>
                      <td>
                        <span class:list={['pill', 'status-' + p.status]}>
                          {visibility(p)}
                        </span>
                        {p.featured && p.status !== 'published' && (
                          <small class="field-help">
                            Pin appears after publishing
                          </small>
                        )}
                      </td>
                      <td>
                        <time data-local-time datetime={p.working_updated_at}>
                          {p.working_updated_at.slice(0, 10)}
                        </time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {!listing.items.length && (
              <div class="empty">
                <p>No posts match these filters.</p>
                <a href="/admin/edit">Create a post</a>
              </div>
            )}
            <Pagination {...listing} url={Astro.url} />
          </>
        )}
        {page === 'preview' && post && (
          <>
            <p class="notice">
              Private preview · Changes here may differ from the live article.
            </p>
            <a href={'/admin/edit?id=' + id}>Continue editing →</a>
            <article class="article admin-preview">
              <header class="article-header">
                <h1>{post.title}</h1>
                <p class="lead">{post.summary}</p>
                <div class="tags">
                  {post.tags.map((tag: string) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </header>
              {post.image && <img class="cover" src={post.image} alt="" />}
              <div class="prose" set:html={renderMarkdown(post.body)} />
            </article>
          </>
        )}
        {page === 'edit' && post && (
          <>
            <form
              id="post-form"
              method="post"
              action="/api/admin/post"
              data-status={post.status}
              data-live={String(live)}
              data-published-at={post.published_at || ''}
            >
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={id || ''} />
              <input type="hidden" name="version" value={post.edit_version} />
              <input type="hidden" name="request_key" value={randomUUID()} />
              <div class="editor-actionbar">
                <div>
                  <span id="post-status" class="pill">
                    {visibility(post)}
                  </span>
                  <span id="save-status" role="status" aria-live="polite">
                    {id ? 'All changes saved' : 'Add a title to start writing'}
                  </span>
                </div>
                <div class="action-buttons">
                  <button type="button" id="preview-button" class="secondary">
                    Preview
                  </button>
                  {post.status !== 'trash' && (
                    <>
                      <button
                        type="submit"
                        class="secondary"
                        name="intent"
                        value="save"
                      >
                        Save draft
                      </button>
                      <button type="button" data-post-intent="publish">
                        {live
                          ? 'Update live post'
                          : post.status === 'published'
                            ? 'Publish now'
                            : 'Publish'}
                      </button>
                    </>
                  )}
                </div>
              </div>
              <div id="editor-error" role="alert" hidden />
              <button type="button" id="download-draft" class="quiet" hidden>
                Download your unsaved text
              </button>
              {post.status === 'trash' && (
                <p class="notice">
                  This post is hidden. Restore it to drafts before editing.
                </p>
              )}
              <div class="editor-layout">
                <section class="editor-main admin-card">
                  <fieldset disabled={post.status === 'trash'}>
                    <label>
                      Title
                      <input
                        name="title"
                        id="post-title"
                        value={post.title}
                        required
                        maxlength="240"
                        placeholder="What’s on your mind?"
                      />
                    </label>
                    {creator(post.created_by_token_id) && (
                      <p class="field-help">
                        Created by {creator(post.created_by_token_id)}
                      </p>
                    )}
                    <label>
                      Summary
                      <textarea
                        name="summary"
                        data-original-value={JSON.stringify(post.summary)}
                        rows="3"
                        maxlength="1000"
                        set:text={'\n' + post.summary}
                      />
                    </label>
                    <div
                      class="editor-modes"
                      role="group"
                      aria-label="Editing mode"
                    >
                      <button
                        type="button"
                        class="quiet"
                        id="mode-visual"
                        aria-pressed="true"
                      >
                        Visual
                      </button>
                      <button
                        type="button"
                        class="quiet"
                        id="mode-source"
                        aria-pressed="false"
                      >
                        Markdown
                      </button>
                      <span id="word-count" />
                    </div>
                    <p id="source-warning" class="notice" hidden />
                    <div
                      class="editor-toolbar"
                      role="toolbar"
                      aria-label="Text formatting"
                    >
                      {[
                        'Bold',
                        'Italic',
                        'Heading',
                        'List',
                        'Numbered list',
                        'Quote',
                        'Link',
                        'Image',
                        'Code',
                        'Table',
                        'Undo',
                        'Redo',
                      ].map((label) => (
                        <button
                          type="button"
                          data-format={label.toLowerCase().replaceAll(' ', '-')}
                          aria-label={label}
                        >
                          {label}
                        </button>
                      ))}
                    </div>
                    <div
                      id="visual-editor"
                      class="prose visual-editor"
                      aria-label="Article body"
                    />
                    <label id="source-label" hidden>
                      Markdown
                      <textarea
                        class="markdown-editor"
                        id="body"
                        name="body"
                        data-original-value={JSON.stringify(post.body)}
                        rows="22"
                        set:text={'\n' + post.body}
                      />
                    </label>
                    <details class="indent-repair">
                      <summary>Fix old accidental indentation</summary>
                      <p class="field-help">
                        Preview removal of the editor’s old whitespace wrapper.
                        Code and nested lists inside the article are preserved.
                      </p>
                      <button type="button" id="preview-repair" class="quiet">
                        Preview correction
                      </button>
                      <div id="repair-comparison" hidden>
                        <div class="comparison-grid">
                          <div>
                            <h3>Before</h3>
                            <pre id="repair-before" />
                          </div>
                          <div>
                            <h3>After</h3>
                            <pre id="repair-after" />
                          </div>
                        </div>
                        <button
                          type="button"
                          class="secondary"
                          id="apply-repair"
                        >
                          Apply correction
                        </button>
                        <button
                          type="button"
                          class="quiet"
                          id="undo-repair"
                          hidden
                        >
                          Undo correction
                        </button>
                      </div>
                      <output id="repair-result" />
                    </details>
                  </fieldset>
                </section>
                <aside class="editor-aside">
                  <section class="admin-card">
                    <h2>Publication</h2>
                    <p id="visibility-help">
                      {live
                        ? 'Readers see the current live article. Draft changes stay private until you update it.'
                        : post.status === 'published'
                          ? 'The scheduled version stays private until its publication time. Use Schedule post again to include draft changes, or Publish now to go live immediately.'
                          : 'This post is private. Publish when you are ready.'}
                    </p>
                    {live && (
                      <a id="view-live" href={'/posts/' + post.live_slug}>
                        View live post ↗
                      </a>
                    )}
                    {post.published_at && (
                      <p class="field-help">
                        Publication:{' '}
                        <time data-local-time datetime={post.published_at}>
                          {post.published_at}
                        </time>
                      </p>
                    )}
                    {!live && post.status !== 'trash' && (
                      <details>
                        <summary>Schedule publication</summary>
                        <label>
                          Publication date <span data-timezone />
                          <input type="datetime-local" id="scheduled-at" />
                        </label>
                        <button
                          type="button"
                          class="secondary"
                          data-post-intent="schedule"
                        >
                          Schedule post
                        </button>
                      </details>
                    )}
                    {post.status === 'published' && (
                      <button
                        type="button"
                        class="quiet"
                        data-post-intent="unpublish"
                      >
                        Unpublish
                      </button>
                    )}
                    <button
                      type="button"
                      class="quiet"
                      data-post-intent={
                        post.status === 'trash' ? 'restore' : 'trash'
                      }
                    >
                      {post.status === 'trash'
                        ? 'Restore to drafts'
                        : 'Move to trash'}
                    </button>
                    <label class="checkbox">
                      <input
                        id="pin-toggle"
                        type="checkbox"
                        disabled={post.status === 'trash'}
                        checked={post.featured}
                      />
                      Pinned
                    </label>
                    <p class="field-help">
                      All pinned public posts appear on the homepage. Draft pins
                      appear after publishing.
                    </p>
                  </section>
                  <section class="admin-card">
                    <h2>Post details</h2>
                    <label>
                      Slug
                      <input
                        name="slug"
                        id="slug"
                        value={post.slug}
                        pattern="[a-z0-9]+(-[a-z0-9]+)*"
                        maxlength="180"
                        required
                      />
                    </label>
                    <p class="field-help">
                      Changing a published URL keeps a redirect from the old
                      URL.
                    </p>
                    <label>
                      Type
                      <select name="type">
                        {[
                          ['article', 'Article'],
                          ['note', 'Note'],
                          ['x_post', 'X post / thread'],
                        ].map(([value, label]) => (
                          <option value={value} selected={post.type === value}>
                            {label}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label>
                      Tags (comma separated)
                      <input
                        name="tags"
                        value={post.tags.join(', ')}
                        list="tag-suggestions"
                        placeholder="building, technology"
                      />
                    </label>
                    <datalist id="tag-suggestions">
                      {knownTags.map((t) => (
                        <option value={t.tag} />
                      ))}
                    </datalist>
                    <label>
                      Original URL
                      <input
                        name="source_url"
                        type="url"
                        value={post.source_url}
                      />
                    </label>
                    <input type="hidden" name="image" value={post.image} />
                    <img
                      id="cover-preview"
                      src={post.image || undefined}
                      alt="Selected cover"
                      hidden={!post.image}
                      class="cover-thumbnail"
                    />
                  </section>
                </aside>
              </div>
            </form>
            <div class="editor-support-grid">
              {post.status !== 'trash' && <MediaPicker csrf={csrf} body />}
              <section class="admin-card" id="revision-panel">
                <h2>Revision history</h2>
                <p class="field-help">
                  Preview a revision before restoring. Restoring saves a private
                  draft and keeps the live article available.
                </p>
                <div class="revision-list">
                  {revisions.map((r) => (
                    <button
                      type="button"
                      class="revision-button"
                      data-revision={r.id}
                    >
                      <time data-local-time datetime={r.created_at}>
                        {r.created_at}
                      </time>
                      <span>{r.kind}</span>
                    </button>
                  ))}
                </div>
                {!revisions.length && <p>No previous revisions yet.</p>}
                <div id="revision-comparison" hidden>
                  <div class="comparison-grid">
                    <div>
                      <h3>Current draft</h3>
                      <pre id="revision-current" />
                    </div>
                    <div>
                      <h3>Selected revision</h3>
                      <pre id="revision-selected" />
                    </div>
                  </div>
                  <button
                    type="button"
                    id="restore-revision"
                    class="secondary"
                    disabled={post.status === 'trash'}
                  >
                    Restore as private draft
                  </button>
                </div>
                <output id="revision-result" role="status" />
              </section>
            </div>
            <dialog id="preview-dialog">
              <div class="preview-dialog-heading">
                <h2>Private preview</h2>
                <button type="button" id="close-preview" class="quiet">
                  Close preview
                </button>
              </div>
              <article class="article admin-preview">
                <header class="article-header">
                  <h1 id="preview-title" />
                  <p class="lead" id="preview-summary" />
                </header>
                <img id="preview-cover" class="cover" alt="" hidden />
                <div id="preview" class="prose" />
              </article>
            </dialog>
            <dialog id="link-dialog">
              <form method="dialog">
                <h2>Insert a link</h2>
                <label>
                  Link text
                  <input id="link-text" />
                </label>
                <label>
                  URL
                  <input id="link-url" type="url" value="https://" required />
                </label>
                <div class="action-buttons">
                  <button value="insert">Insert link</button>
                  <button value="cancel" class="secondary" formnovalidate>
                    Cancel
                  </button>
                </div>
              </form>
            </dialog>
            <dialog id="image-dialog">
              <form method="dialog">
                <h2>Insert or edit image</h2>
                <label>
                  Image URL
                  <input id="inline-image-url" required />
                </label>
                <label>
                  Image description (alt text)
                  <input id="inline-image-alt" maxlength="500" />
                </label>
                <div class="action-buttons">
                  <button value="insert">Save image</button>
                  <button value="cancel" class="secondary" formnovalidate>
                    Cancel
                  </button>
                </div>
              </form>
            </dialog>
          </>
        )}
        {page === 'settings' && (
          <div class="editor-layout">
            <form
              class="admin-card"
              action="/api/admin/settings"
              method="post"
              data-admin-form
            >
              <input type="hidden" name="csrf" value={csrf} />
              {[
                ['site_title', 'Site title'],
                ['description', 'Site description'],
              ].map(([key, label]) => (
                <label>
                  {label}
                  <input name={key} value={setting(key)} maxlength="10000" />
                </label>
              ))}
              <label>
                Biography
                <textarea
                  name="bio"
                  data-original-value={JSON.stringify(setting('bio'))}
                  rows="5"
                  set:text={'\n' + setting('bio')}
                />
              </label>
              <h2>Profile links</h2>
              <div id="profile-links">
                {[...links, { label: '', url: '' }].map((link) => (
                  <div class="profile-link-row">
                    <label>
                      Label
                      <input
                        name="link_label"
                        value={link.label}
                        maxlength="100"
                      />
                    </label>
                    <label>
                      URL
                      <input name="link_url" type="url" value={link.url} />
                    </label>
                    <button type="button" class="quiet remove-link">
                      Remove
                    </button>
                  </div>
                ))}
              </div>
              <button type="button" class="quiet" id="add-link">
                + Add link
              </button>
              <input type="hidden" name="photo" value={setting('photo')} />
              <img
                data-image-preview="photo"
                src={setting('photo') || undefined}
                hidden={!setting('photo')}
                alt="Profile photo"
                class="cover-thumbnail"
              />
              <div class="form-footer">
                <button>Save settings</button>
              </div>
            </form>
            <aside>
              <MediaPicker csrf={csrf} target="photo" />
            </aside>
          </div>
        )}
        {page === 'projects' && !missing && (
          <ProjectsWorkspace
            csrf={csrf}
            url={Astro.url}
            projects={allProjects}
            selectedProject={selectedProject}
            editing={projectEditing}
          />
        )}
        {page === 'tags' && (
          <>
            <p>
              Manage tags across live posts and private drafts. Renaming to an
              existing tag merges them.
            </p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Tag</th>
                    <th>Published</th>
                    <th>Draft / scheduled</th>
                    <th>Total posts</th>
                  </tr>
                </thead>
                <tbody>
                  {knownTags.map((t) => (
                    <tr>
                      <td>
                        <a href={'/admin?tag=' + encodeURIComponent(t.tag)}>
                          #{t.tag}
                        </a>
                      </td>
                      <td>{t.published}</td>
                      <td>{t.drafts}</td>
                      <td>{t.count}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <form
              class="settings-form admin-card"
              action="/api/admin/rename-tag"
              method="post"
              data-admin-form
              data-reload
              data-confirm="Apply this tag change across all affected posts, including live articles?"
            >
              <input type="hidden" name="csrf" value={csrf} />
              <label>
                Existing tag
                <select name="old" id="old-tag" required>
                  <option value="">Choose a tag</option>
                  {knownTags.map((t) => (
                    <option value={t.tag} data-count={t.count}>
                      {t.tag} ({t.count} posts)
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Rename / merge into
                <input
                  name="new"
                  list="all-tags"
                  pattern="[a-z0-9-]*"
                  maxlength="50"
                  placeholder="Leave empty to remove the tag"
                />
              </label>
              <datalist id="all-tags">
                {knownTags.map((t) => (
                  <option value={t.tag} />
                ))}
              </datalist>
              <p id="tag-impact" class="field-help">
                Choose a tag to see how many posts will change.
              </p>
              <button>Update tag across posts</button>
            </form>
          </>
        )}
        {page === 'inbox' && (
          <>
            <p>
              Imported entries stay private. Select entries to create a draft;
              original records are preserved.
            </p>
            {importReport && (
              <section class="notice" role="status">
                <strong>Import complete</strong>
                <p>
                  {importReport.imported || 0} imported ·{' '}
                  {importReport.duplicates || 0} duplicates skipped ·{' '}
                  {importReport.errors?.length || 0} issues
                </p>
                {importReport.errors?.length > 0 && (
                  <details>
                    <summary>Review import issues</summary>
                    <ul>
                      {importReport.errors.map((error: string) => (
                        <li>{error}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </section>
            )}
            <div class="form-grid">
              <details class="admin-card">
                <summary>Import an archive</summary>
                <form
                  action="/api/admin/import"
                  method="post"
                  enctype="multipart/form-data"
                  data-admin-form
                  data-import
                >
                  <input type="hidden" name="csrf" value={csrf} />
                  <label>
                    Official X archive (.zip, tweets.js, JSON; up to 32 MB)
                    <input
                      name="file"
                      type="file"
                      accept=".zip,.js,.json"
                      required
                    />
                  </label>
                  <button>Import to private inbox</button>
                </form>
              </details>
              <details class="admin-card">
                <summary>Add an X post manually</summary>
                <form
                  action="/api/admin/manual-x"
                  method="post"
                  data-admin-form
                  data-redirect="/admin/inbox"
                >
                  <input type="hidden" name="csrf" value={csrf} />
                  <label>
                    X post ID
                    <input name="x_id" required pattern="[0-9]{1,30}" />
                  </label>
                  <label>
                    Original URL (optional)
                    <input name="url" type="url" />
                  </label>
                  <label>
                    Date <span data-timezone />
                    <input
                      name="date"
                      type="datetime-local"
                      data-utc-input
                      required
                    />
                  </label>
                  <label>
                    Original text
                    <textarea name="text" required rows="4" />
                  </label>
                  <button>Add to inbox</button>
                </form>
              </details>
            </div>
            <form class="admin-filters" method="get" action="/admin/inbox">
              <label class="search-field">
                Search imported text
                <input name="q" type="search" value={inboxQuery} />
              </label>
              <button class="secondary">Search</button>
              <a href="/admin/inbox">Reset</a>
            </form>
            <form
              action="/api/admin/convert"
              method="post"
              id="inbox-selection"
              data-admin-form
              data-convert
            >
              <input type="hidden" name="csrf" value={csrf} />
              <div class="bulk-actions">
                <label class="checkbox">
                  <input type="checkbox" data-select-all="inbox-selection" />
                  Select page
                </label>
                <span data-selection-count>0 selected</span>
                <span class="field-help">Selection applies to this page.</span>
              </div>
              {inbox.map((item) => (
                <article class="inbox-item">
                  <label class="checkbox">
                    <input
                      type="checkbox"
                      name="selected"
                      value={item.id}
                      disabled={Boolean(item.post_id)}
                    />
                    <time data-local-time datetime={item.date}>
                      {item.date}
                    </time>
                  </label>
                  <p>{item.text}</p>
                  <a href={item.url} rel="noopener noreferrer">
                    Original ↗
                  </a>
                  {item.post_id && (
                    <a
                      class="inbox-draft-link"
                      href={'/admin/edit?id=' + item.post_id}
                    >
                      Open resulting draft →
                    </a>
                  )}
                  {JSON.parse(item.media).map((src: string) => (
                    <img
                      src={src}
                      width="120"
                      alt="Imported attachment"
                      loading="lazy"
                    />
                  ))}
                  <details>
                    <summary>Preserved original record</summary>
                    <pre>{item.original}</pre>
                  </details>
                </article>
              ))}
              {!inbox.length && <p class="empty">No imported entries match.</p>}
              <div class="form-grid">
                <label>
                  Draft title
                  <input name="title" required maxlength="240" />
                </label>
                <label>
                  Convert selection to
                  <select name="type">
                    <option value="x_post">X post / thread</option>
                    <option value="note">Note</option>
                    <option value="article">Article</option>
                  </select>
                </label>
              </div>
              <button disabled data-requires-selection>
                Create draft from selection
              </button>
            </form>
            <Pagination
              page={inboxPage}
              pages={inboxPages}
              total={inboxTotal}
              url={Astro.url}
            />
          </>
        )}
      </>
    )
  }
  <script src="../../scripts/admin.ts"></script>
  {page === 'edit' && <script src="../../scripts/editor.ts" />}
  {page === 'projects' && <script src="../../scripts/projects.ts" />}
</Base>
